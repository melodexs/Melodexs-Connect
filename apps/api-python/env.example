# MELODEXS CONNECT Python API — environment template
#
# Copy to the repository root as `.env` for local runs, or configure the
# same values in the hosting provider's dashboard (preferred for staging and
# production). NEVER commit real values. Every production-required value is
# validated at startup: the application refuses to start (or serve) with an
# invalid configuration rather than degrading silently.
#
# Variable reference: apps/api-python/README.md. The application reads the
# repository-root `.env` file when present; hosting providers override it.

# --- Runtime mode (REQUIRED, no default) ---
# development | test | production. Production enables strict validation:
# PostgreSQL-only database, 32+ char session secret, approved WiseSub
# endpoint, live WiseSub environment.
NODE_ENV=development

# --- Server ---
# uvicorn binds to 0.0.0.0:${PORT} in hosting; $PORT is provided by the host.
PORT=3000

# Comma-separated reverse-proxy addresses trusted to supply X-Forwarded-For.
# The npm start command passes this to uvicorn's --forwarded-allow-ips.
# Default 127.0.0.1 = no external proxy trusted (rate limiting and request
# logs key on the direct peer). On Render, set this to the platform's proxy
# addresses per Render's current documentation during staging setup —
# verify the value from Render's docs, not from guesswork. Leaving it unset
# is safe: requests are served normally, they are just attributed to the
# proxy address.
# FORWARDED_ALLOW_IPS=10.x.x.x

# --- Database (REQUIRED in production; PostgreSQL with TLS) ---
# Production must use PostgreSQL with sslmode=verify-full. SQLite is a local
# and test convenience only. Never point tests or development at production.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full

# --- Sessions (REQUIRED in production: 32+ characters) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Sessions are server-side; the cookie name is melodexs_session. Rotating
# this secret invalidates all sessions (users re-login).
# SESSION_SECRET=

# --- Public frontend origin (CORS/origin allow-list) ---
# The deployed frontend origin. Cross-origin mutating requests are checked
# against this value in production.
CHEAPDATA_PUBLIC_URL=https://melodexs-connect.onrender.com

# --- Paystack (REQUIRED for wallet funding in production) ---
# PAYSTACK_SECRET_KEY=sk_live_...
# Webhook URL: https://<api-origin>/api/paystack/webhook (configure the same
# secret in the Paystack dashboard).

# --- WiseSub data provider (REQUIRED in production) ---
# WISESUB_ENVIRONMENT=live
# WISESUB_BASE_URL=https://app.wisesub.com.ng/api/partner/v1
# WISESUB_API_KEY=
# WISESUB_API_SECRET=
# Keep false until staging confirms the provider's terminal failure
# semantics; unknown states remain pending and are reconciled manually.
WISESUB_FAILURE_STATUS_CONFIRMED=false

# --- Multi-provider platform (WiseSub stays primary by default) ---
# MELE DATA adapter (meledata.ng). One base URL serves live and test
# traffic; the API key selects the mode (mele_test_... tokens simulate).
# With MELEDATA_TEST_MODE=1 the adapter fails closed unless the provider
# reports mode="test" and livemode=false on every wallet check.
# MELEDATA_BASE_URL=https://meledata.ng/api/v1/developer
# MELEDATA_API_KEY=
# MELEDATA_TEST_MODE=false
# Opt-in live verification tests (tests/test_meledata_sandbox_live.py):
# require a mele_test_... token plus MELEDATA_TEST_MODE=1.
# MELEDATA_LIVE_TESTS=1 alone is READ-ONLY (wallet, catalog, requery).
# The single purchase-attempt test additionally requires:
# MELEDATA_PURCHASE_TESTS=1 (never by default).
# MELEDATA_LIVE_TESTS=false
# MELEDATA_PURCHASE_TESTS=false

# --- VTpass sandbox validation (sandbox only, never live) ---
# app/vtpass_sandbox.py validates the VTpass contract against the
# documented sandbox. It refuses any non-sandbox host outright, so live
# credentials can never be used by these tests.
# VTPASS_SANDBOX_BASE_URL=https://sandbox.vtpass.com/api
# VTPASS_SANDBOX_API_KEY=
# VTPASS_SANDBOX_PUBLIC_KEY=
# VTPASS_SANDBOX_SECRET_KEY=
# Opt-in live sandbox tests (tests/test_vtpass_sandbox_live.py):
# VTPASS_SANDBOX_LIVE_TESTS=false

# --- Catalog pricing ---
# Percent markup over provider cost for calculated (non-fixed) prices.
CHEAPDATA_MARKUP_PERCENT=2

# --- Brevo transactional email (password reset) ---
# BREVO_API_KEY=xkeysib-...
# BREVO_FROM_EMAIL=support@melodexs-connect.example
# BREVO_FROM_NAME=MELODEXS CONNECT
