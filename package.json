{
  "name": "cheapdata-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "start": "bash scripts/start-python-guarded.sh",
    "start:node": "npm run start --workspace=@cheapdata/api",
    "dev": "bash scripts/start-python-guarded.sh",
    "dev:node": "npm run dev --workspace=@cheapdata/api",
    "test": "npm test --workspace=@cheapdata/api",
    "test:api-python": "bash scripts/test-api-python.sh",
    "lint": "eslint .",
    "api": "npm run start",
    "api:node": "npm run start --workspace=@cheapdata/api",
    "db:fix": "npm run db:fix --workspace=@cheapdata/api",
    "db:reset-fields": "npm run db:reset-fields --workspace=@cheapdata/api",
    "db:purchase-pin": "npm run db:purchase-pin --workspace=@cheapdata/api",
    "make-admin": "npm run make-admin --workspace=@cheapdata/api"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "eslint": "^10.9.1",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "axios": "^1.20.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0"
  },
  "overrides": {
    "ip-address": "^10.7.1"
  }
}
