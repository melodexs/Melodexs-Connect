# Copy to .env for local use. Replace placeholders with local/development values.
# Never commit .env or use production credentials for local work.

PORT=3000
NODE_ENV=development

# Use a dedicated test PostgreSQL database for npm test; never production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE

# Generate a unique local value. Production requires at least 32 characters.
SESSION_SECRET=replace-with-a-random-local-secret

# Paystack credentials are server-side only.
PAYSTACK_SECRET_KEY=

# Public frontend URL used for payment callback and password reset links.
CHEAPDATA_PUBLIC_URL=https://your-frontend.example

# WiseSub reseller API configuration.
WISESUB_BASE_URL=https://app.wisesub.com.ng/api/partner/v1
WISESUB_API_KEY=
WISESUB_API_SECRET=
WISESUB_ENVIRONMENT=test

# Customer price markup over provider cost. Variable name retained for compatibility.
CHEAPDATA_MARKUP_PERCENT=2

# Brevo password reset email configuration.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=MELODEXS CONNECT

# Legacy SQLite path used by some maintenance scripts; the API uses PostgreSQL.
DB_PATH=./apps/api/data/cheapdata.db
